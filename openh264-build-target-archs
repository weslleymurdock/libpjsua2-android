#!/bin/bash -e

set -e

# Source variables from config.conf file
. config.conf
 
 
  
# Configurações gerais
NDK_PATH=/opt/hostedtoolcache/ndk/r28/x64  # Substitua pelo caminho do NDK r28
INSTALL_DIR=$OPENH264_BUILD_OUT_PATH           # Diretório onde os arquivos compilados serão armazenados
OPENH264_SOURCE_DIR=$DOWNLOAD_DIR/$OPENH264_DIR_NAME  # Caminho para o código-fonte da OpenH264
API_LEVEL=28                               # Nível da API do Android
TARGET_ARCHS=("armeabi-v7a" "arm64-v8a" "x86" "x86_64")  # Arquiteturas suportadas

# Preparação do diretório de instalação
mkdir -p "${INSTALL_DIR}"

# Função para compilar a biblioteca para uma arquitetura específica
build_for_arch() {
    ARCH=$1
    case $ARCH in
        "armeabi-v7a")
            TARGET=arm
            ABI="armeabi-v7a"
            CFLAGS="-march=armv7-a -D__ANDROID_API__=$API_LEVEL"
            LDFLAGS="-march=armv7-a -D__ANDROID_API__=$API_LEVEL"
            ;;
        "arm64-v8a")
            TARGET=arm64
            ABI="arm64-v8a"
            CFLAGS="-march=arm64 -D__ANDROID_API__=$API_LEVEL"
            LDFLAGS="-march=arm64 -D__ANDROID_API__=$API_LEVEL"
            ;;
        "x86")
            TARGET=x86
            ABI="x86"
            CFLAGS="-march=i686 -D__ANDROID_API__=$API_LEVEL"
            LDFLAGS="-march=i686 -D__ANDROID_API__=$API_LEVEL"
            ;;
        "x86_64")
            TARGET=x86_64
            ABI="x86_64"
            CFLAGS="-march=x86-64 -D__ANDROID_API__=$API_LEVEL"
            LDFLAGS="-march=x86-64 -D__ANDROID_API__=$API_LEVEL"
            ;;
        *)
            echo "Arquitetura desconhecida: $ARCH"
            exit 1
            ;;
    esac

    echo "Compilando para $ARCH..."

    # Diretórios de saída para a arquitetura atual
    BUILD_DIR=$OPENH264_SOURCE_DIR/build/$ARCH
    OUTPUT_DIR=$INSTALL_DIR/$ARCH
    mkdir -p "$BUILD_DIR"
    mkdir -p "$OUTPUT_DIR"

    # Exportar variáveis do NDK e configuração do Clang
    #export CC="$NDK_PATH/toolchains/llvm/prebuilt/linux-x86_64/bin/clang"
    export CC=`which clang`
    #export CXX="$NDK_PATH/toolchains/llvm/prebuilt/linux-x86_64/bin/clang++"
    export CXX=`which clang++`
    export NDKROOT=$NDK_PATH
    export CFLAGS
    export LDFLAGS

    # Limpar compilações anteriores (ignorar erros caso não exista compilação anterior)
    cd "$OPENH264_SOURCE_DIR"  
    if make clean >/dev/null 2>&1; then
        echo "Limpeza concluída para $ARCH."
    else
        echo "Nenhuma compilação anterior encontrada para $ARCH, continuando..."
    fi

    # Compilar a biblioteca
    make OS=android NDKROOT=$NDK_PATH TARGET=$TARGET NDKLEVEL=$API_LEVEL  

    # Instalar a biblioteca
    make install PREFIX=$BUILD_DIR  

    # Copiar os resultados para o diretório de instalação final
    cp -r "$BUILD_DIR/lib" "$OUTPUT_DIR/"
    cp -r "$BUILD_DIR/include" "$OUTPUT_DIR/"
    echo "Arquivos instalados para $ARCH em $OUTPUT_DIR"
}

# Compilar para cada arquitetura no array TARGET_ARCHS
for ARCH in "${TARGET_ARCHS[@]}"; do
    build_for_arch "$ARCH"
done
 
echo "Finished building OpenH264! Check output folder: ${OPENH264_BUILD_OUT_PATH}"

set +e
