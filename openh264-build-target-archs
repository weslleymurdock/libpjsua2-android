#!/bin/bash -e

set -e

# Source variables from config.conf file
. config.conf
   
NDK_PATH=/opt/hostedtoolcache/ndk/r28/x64 
INSTALL_DIR=$OPENH264_BUILD_OUT_PATH           
OPENH264_SOURCE_DIR=$DOWNLOAD_DIR/$OPENH264_DIR_NAME   
API_LEVEL=28                               
TARGET_ARCHS=("armeabi-v7a" "arm64-v8a" "x86" "x86_64")  
 
mkdir -p "${INSTALL_DIR}"

 
build_for_arch() {
    ARCH=$1
    case $ARCH in
        "armeabi-v7a")
            TARGET=arm
            ABI="armeabi-v7a"
            CFLAGS="-march=armv7-a -D__ANDROID_API__=$API_LEVEL"
            LDFLAGS="-march=armv7-a -D__ANDROID_API__=$API_LEVEL"
            ;;
        "arm64-v8a")
            TARGET=arm64
            ABI="arm64-v8a"
            CFLAGS="-march=arm64 -D__ANDROID_API__=$API_LEVEL"
            LDFLAGS="-march=arm64 -D__ANDROID_API__=$API_LEVEL"
            ;;
        "x86")
            TARGET=x86
            ABI="x86" 
            CFLAGS="-march=i686 -D__ANDROID_API__=$API_LEVEL"
            LDFLAGS="-march=i686 -D__ANDROID_API__=$API_LEVEL"
            ;;
        "x86_64")
            TARGET=x86_64
            ABI="x86_64" 
            CFLAGS="-march=x86-64 -D__ANDROID_API__=$API_LEVEL"
            LDFLAGS="-march=x86-64 -D__ANDROID_API__=$API_LEVEL"
            ;;
        *)
            echo "Arquitetura desconhecida: $ARCH"
            exit 1
            ;;
    esac

    echo "Compilando para $ARCH..."
 
    BUILD_DIR=$OPENH264_SOURCE_DIR/build/$ARCH
    OUTPUT_DIR=$INSTALL_DIR/$ARCH
    mkdir -p "$BUILD_DIR"
    mkdir -p "$OUTPUT_DIR"

    export CC="${NDK_PATH}/toolchains/llvm/prebuilt/linux-x86_64/bin/clang"
    export CXX="${NDK_PATH}/toolchains/llvm/prebuilt/linux-x86_64/bin/clang++"
    export NDKROOT=$NDK_PATH
    export CFLAGS
    export LDFLAGS
    export CFLAGS="--sysroot=${NDK_PATH}/toolchains/llvm/prebuilt/linux-x86_64/sysroot ${CFLAGS}"
    export LDFLAGS="--sysroot=${NDK_PATH}/toolchains/llvm/prebuilt/linux-x86_64/sysroot ${LDFLAGS}"
    
    cd "$OPENH264_SOURCE_DIR"  
    
    make clean || echo "nothing to clean"
     
 
    make APP_PLATFORM=android-28 OS=android NDKROOT=$NDK_PATH TARGET=$TARGET NDKLEVEL=$API_LEVEL NDK_TOOLCHAIN_VERSION=clang APP_STL=c++_static 
 
    make install PREFIX=$BUILD_DIR  
 
    cp -r "$BUILD_DIR/lib" "$OUTPUT_DIR/"
    cp -r "$BUILD_DIR/include" "$OUTPUT_DIR/"
    echo "Arquivos instalados para $ARCH em $OUTPUT_DIR"
}
 
for ARCH in "${TARGET_ARCHS[@]}"; do
    build_for_arch "$ARCH"
done
 
echo "Finished building OpenH264! Check output folder: ${OPENH264_BUILD_OUT_PATH}"

set +e
